{
    "name": "codecrafter/laravel-menu",
    "description": "Tree-based menu builder for Laravel with Filament 5 admin panel integration. Supports nested menus, mega-menu columns, caching and Blade components.",
    "keywords": [
        "laravel",
        "filament",
        "menu",
        "navigation",
        "tree",
        "mega-menu",
        "codecrafter"
    ],
    "homepage": "https://codecrafter.pro",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "CodeCrafter",
            "email": "dev@codecrafter.pro",
            "homepage": "https://codecrafter.pro"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.19",
        "illuminate/contracts": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nunomaduro/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CodeCrafter\\Menu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeCrafter\\Menu\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "CodeCrafter\\Menu\\MenuServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
